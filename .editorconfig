# Shared basics (STYLE-1), the same text as the [*] and two-space sections of winui-app-kit's
# canonical .editorconfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,cjs,json,jsonc,yml,yaml,css,scss,md}]
indent_size = 2
